# =============================================
# Resurte.me — Variables de Entorno
# =============================================
# Copia este archivo como .env.local y completa los valores.

# ---- Supabase (Base de datos + Auth + Storage) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google Site Verification ----
# Get from Google Search Console → Settings → Verification details
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- CSP Report-Only (monitoreo de endurecimiento) ----
# Si se define a `true`, el proxy envía ADEMÁS Content-Security-Policy-Report-Only
# con una política endurecida (script-src sin hosts de GA4/Meta, solo nonce +
# strict-dynamic). Los navegadores modernos no deberían generar reportes (los
# scripts de terceros se cargan vía strict-dynamic); los reportes que lleguen
# indican dependencia del fallback CSP2 y se observan en /api/csp-report.
# Dejar vacío/ausente mantiene solo la CSP en modo enforce.
CSP_REPORT_ONLY=false

# ---- Analytics ----
# Google Analytics 4 Measurement ID (ej: G-XXXXXXXXXX).
# Alias compatible: GOOGLEANALYTICS (se lee si NEXT_PUBLIC_GA_MEASUREMENT_ID no está definido)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID (ej: 1234567890123456).
# Alias compatible: FBPIXEL (se lee si NEXT_PUBLIC_META_PIXEL_ID no está definido)
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Feature Flags & A/B Testing ----
# Activa el banner promocional en la landing (PromoBanner). `true` lo enciende.
NEXT_PUBLIC_FEATURE_PROMO_BANNER=true

# ---- Emails transaccionales (Resend) ----
# API key de Resend para envío de correos (workflows de email).
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=

# ---- Admin API ----
# Secret compartido para endpoints administrativos (ej: /api/admin/update-images).
# Se envía como header `x-admin-secret`. Genera uno aleatorio con: openssl rand -hex 32
ADMIN_API_SECRET=

# Token para el seed de productos (/api/admin/seed-products). Fail-closed:
# si no está definido, el endpoint responde 503. Header: `x-seed-token`
SEED_API_TOKEN=

# ---- Scripts dev (opcional) ----
# Ruta a un archivo JSON con el plan de descarga para scripts de imágenes
# (scripts/fetch-real-product-images*.mjs). Solo uso local.
# PLAN=./plan.json

# ---- WhatsApp ----
# Número de WhatsApp para pedidos (formato internacional sin +, ej: 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=5216145337486

# ---- Vercel Edge Middleware (Geolocalización) ----
# NEXT_PUBLIC_VERCEL_IP_GEOLOCATION_API_KEY=

# ---- Meta WhatsApp Cloud API (v21.0) ----
# Obtener en: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret de la app de Facebook (Meta) — valida X-Hub-Signature-256
# en POST /api/whatsapp/webhook. Sin él el webhook responde 503.
WHATSAPP_APP_SECRET=

# ---- Vercel Cron (Workflows automáticos) ----
# Token secreto para proteger endpoints CRON
CRON_SECRET=

# ---- Stripe (pagos) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ---- Google OAuth ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- CRO: cupón de recuperación por exit-intent ----
# Código de cupón que se ofrece en el modal de abandono de carrito. Debe
# existir en la tabla `coupons`. Déjalo vacío para capturar el lead sin cupón.
# NEXT_PUBLIC_EXIT_INTENT_COUPON=BIENVENIDO10

# ---- Admin (acceso a /admin y a las rutas admin) ----
# Emails separados por coma autorizados para gestionar pedidos, confirmar
# pagos (dispara cashback) y editar productos. Ej: ADMIN_EMAILS=juan@x.mx,ana@x.mx
ADMIN_EMAILS=

# ---- Comercialización (CRM de vendedores) ----
# Tasa de comisión global para el cálculo estimado del panel del vendedor.
# Fracción decimal (0.05 = 5%). Por defecto 0.05.
# SELLER_COMMISSION_RATE=0.05

# ─── OmniRoute (local AI gateway, optional) ─────────────────────
# Local AI router: point any OpenAI-compatible SDK at OMNIROUTE_BASE_URL
# with OMNIROUTE_API_KEY. Requires the omniroute server running locally.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=sk-your-omniroute-key

# ---- Agente de Ventas IA (/comercializacion/agente) ----
# API compatible con OpenAI Chat Completions para redactar los WhatsApp
# del agente. Prioridad: OMNIROUTE_* (arriba) > OPENAI_* (aquí).
# Sin estas variables el agente usa las plantillas del plan de prospección
# (funciona igual, con mensajes deterministas).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Modelo a usar (default gpt-4o-mini). AGENT_MODEL tiene prioridad.
# AGENT_MODEL=gpt-4o-mini
