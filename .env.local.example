# =============================================
# Resurte.me — Variables de Entorno
# =============================================
# Copia este archivo como .env.local y completa los valores.

# ---- Supabase (Base de datos + Auth + Storage) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Resurte.me

# ---- Google Site Verification ----
# Get from Google Search Console → Settings → Verification details
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Analytics ----
# Google Analytics 4 Measurement ID (ej: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID (ej: 1234567890123456)
NEXT_PUBLIC_META_PIXEL_ID=

# ---- WhatsApp ----
# Número de WhatsApp para pedidos (formato internacional sin +, ej: 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=5216145337486

# ---- Vercel Edge Middleware (Geolocalización) ----
# NEXT_PUBLIC_VERCEL_IP_GEOLOCATION_API_KEY=

# ---- Meta WhatsApp Cloud API (v21.0) ----
# Obtener en: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret de la app de Facebook (Meta) — valida X-Hub-Signature-256
# en POST /api/whatsapp/webhook. Sin él el webhook responde 503.
WHATSAPP_APP_SECRET=

# ---- Vercel Cron (Workflows automáticos) ----
# Token secreto para proteger endpoints CRON
CRON_SECRET=

# ---- Pagos México ----
# Conekta (tarjetas MX, MSI, OXXO, SPEI)
CONEKTA_API_KEY=
CONEKTA_WEBHOOK_SECRET=
# Mercado Pago (link de pago, QR)
MERCADOPAGO_ACCESS_TOKEN=

# ---- Stripe (internacional, respaldo) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ---- Google OAuth ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Admin (acceso a /admin y a las rutas admin) ----
# Emails separados por coma autorizados para gestionar pedidos, confirmar
# pagos (dispara cashback) y editar productos. Ej: ADMIN_EMAILS=juan@x.mx,ana@x.mx
ADMIN_EMAILS=
