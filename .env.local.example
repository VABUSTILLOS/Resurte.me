# =============================================
# Resurte.me — Variables de Entorno
# =============================================
# Copia este archivo como .env.local y completa los valores.

# ---- Supabase (Base de datos + Auth + Storage) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google Site Verification ----
# Get from Google Search Console → Settings → Verification details
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- CSP Report-Only (monitoreo de endurecimiento) ----
# Si se define a `true`, el proxy envía ADEMÁS Content-Security-Policy-Report-Only
# con una política endurecida (script-src sin hosts de GA4/Meta, solo nonce +
# strict-dynamic). Los navegadores modernos no deberían generar reportes (los
# scripts de terceros se cargan vía strict-dynamic); los reportes que lleguen
# indican dependencia del fallback CSP2 y se observan en /api/csp-report.
# Dejar vacío/ausente mantiene solo la CSP en modo enforce.
CSP_REPORT_ONLY=false

# ---- Analytics ----
# Google Analytics 4 Measurement ID (ej: G-XXXXXXXXXX).
# Alias compatible: GOOGLEANALYTICS (se lee si NEXT_PUBLIC_GA_MEASUREMENT_ID no está definido)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID (ej: 1234567890123456).
# Alias compatible: FBPIXEL (se lee si NEXT_PUBLIC_META_PIXEL_ID no está definido)
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Feature Flags & A/B Testing ----
# Activa el banner promocional en la landing (PromoBanner). `true` lo enciende.
NEXT_PUBLIC_FEATURE_PROMO_BANNER=true

# ---- Emails transaccionales (Resend) ----
# API key de Resend para envío de correos (workflows de email).
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=

# ---- Scripts dev (opcional) ----
# Ruta a un archivo JSON con el plan de descarga para scripts de imágenes
# (scripts/fetch-real-product-images*.mjs). Solo uso local.
# PLAN=./plan.json

# ---- WhatsApp ----
# Número de WhatsApp para pedidos (formato internacional sin +, ej: 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=5216145337486

# ---- Vercel Edge Middleware (Geolocalización) ----
# NEXT_PUBLIC_VERCEL_IP_GEOLOCATION_API_KEY=

# ---- Meta WhatsApp Cloud API (v21.0) ----
# Obtener en: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret de la app de Facebook (Meta) — valida X-Hub-Signature-256
# en POST /api/whatsapp/webhook. Sin él el webhook responde 503.
WHATSAPP_APP_SECRET=

# ---- Vercel Cron (Workflows automáticos) ----
# Token secreto para proteger endpoints CRON
CRON_SECRET=

# ---- Stripe (pagos) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# ---- Stripe Connect (cobros por restaurante) ----
# Enruta los cargos con tarjeta de FoodOS a la cuenta Express del restaurante
# (destination charge) en vez de a la cuenta de la plataforma. Debe ser
# exactamente "true" o "1"; cualquier otro valor lo deja apagado.
# Requiere activar Connect antes en el Dashboard de Stripe (Settings → Connect).
# Ver docs/OPS.md §11.
STRIPE_CONNECT_ENABLED=
# País de las cuentas Express (ISO-2). Por defecto MX.
STRIPE_CONNECT_COUNTRY=MX

# ---- Google OAuth ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- CRO: cupón de recuperación por exit-intent ----
# Código de cupón que se ofrece en el modal de abandono de carrito. Debe
# existir en la tabla `coupons`. Déjalo vacío para capturar el lead sin cupón.
# NEXT_PUBLIC_EXIT_INTENT_COUPON=BIENVENIDO10

# ---- Admin (acceso a /admin y a las rutas admin) ----
# Emails separados por coma autorizados como admin (bootstrap/emergencia).
# La gestión continua de admins se hace desde /admin/usuarios (profiles.role).
# Ej: ADMIN_EMAILS=juan@x.mx,ana@x.mx
ADMIN_EMAILS=

# ---- Correo de autenticación (Supabase Auth) ----
# El registro por email/contraseña, el enlace mágico y la recuperación de
# contraseña requieren un SMTP PROPIO configurado en el Dashboard de Supabase
# (Project Settings → Authentication → SMTP). El servicio por defecto es solo
# para desarrollo y los correos no llegan. Ver docs/OPS.md §8.1.

# ---- Comercialización (CRM de vendedores) ----
# Tasa de comisión global para el cálculo estimado del panel del vendedor.
# Fracción decimal (0.05 = 5%). Por defecto 0.05.
# SELLER_COMMISSION_RATE=0.05

# ─── OmniRoute (local AI gateway, optional) ─────────────────────
# Local AI router: point any OpenAI-compatible SDK at OMNIROUTE_BASE_URL
# with OMNIROUTE_API_KEY. Requires the omniroute server running locally.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=sk-your-omniroute-key

# ---- Agente de Ventas IA (/comercializacion/agente) ----
# API compatible con OpenAI Chat Completions para redactar los WhatsApp
# del agente. Prioridad: OMNIROUTE_* (arriba) > OPENAI_* (aquí).
# Sin estas variables el agente usa las plantillas del plan de prospección
# (funciona igual, con mensajes deterministas).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Modelo a usar (default gpt-4o-mini). AGENT_MODEL tiene prioridad.
# AGENT_MODEL=gpt-4o-mini
# Ejemplo con DeepSeek (compatible con OpenAI, más barato y buen español):
# OPENAI_API_KEY=sk-tu-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AGENT_MODEL=deepseek-chat

# ---- Capa de IA de FoodOS (Mesero IA, Marketing IA, sitio IA) ----
# Usa el MISMO resolutor de proveedores que el agente (OmniRoute > OpenAI >
# Kie.ai), pero con guardarraíles propios. Ver src/lib/ai/llm.ts.
# Si no hay ninguna credencial, la capa degrada a plantillas deterministas y
# el producto sigue funcionando: nunca deja al comensal sin respuesta.
#
# Kill switch: apaga toda la IA de FoodOS sin borrar credenciales.
# AI_ENABLED=false
# Timeout por intento (ms, default 12000) y reintentos extra (default 1).
# AI_TIMEOUT_MS=12000
# AI_MAX_RETRIES=1
# Tope diario de tokens por restaurante (default 60000). Al agotarse, esa
# capacidad pasa a plantilla hasta el día siguiente (America/Mexico_City).
# AI_DAILY_TOKEN_CAP=60000
# Alternativa a OPENAI_* para la capa de IA (Kie.ai como proveedor de chat).
# KIE_AI_MODEL=gpt-4o-mini

# ---- SMS para Marketing IA (canal alternativo de WhatsApp) ----
# El SMS es de PLATAFORMA (una sola cuenta para todos los restaurantes), no por
# restaurante: el token de WhatsApp sí es por restaurante, el SMS no. Ver
# src/lib/messaging/sms.ts. Si no hay credenciales, el canal SMS simplemente
# desaparece y las campañas siguen saliendo por WhatsApp.
#
# Kill switch del canal SMS.
# SMS_ENABLED=false
# Proveedor de SMS (hoy solo "twilio"; cualquier otro valor desactiva el canal).
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente: número E.164 (+52155...) o Messaging Service SID (MGxxxx).
# TWILIO_FROM=+5215500000000
# País por defecto para normalizar números locales de 10 dígitos (default 52).
# SMS_DEFAULT_COUNTRY=52
# Timeout por envío en ms (default 10000).
# SMS_TIMEOUT_MS=10000

# ---- Reparto externo para la Flotilla (nivel Oro) ----
# Uber Direct es de PLATAFORMA (una sola cuenta para todos los restaurantes),
# igual que el SMS. Ver src/lib/flotilla/provider.ts. Si no hay credenciales,
# el proveedor desaparece y la Flotilla opera solo con repartidores propios:
# el botón "Enviar a reparto externo" devuelve un error legible.
#
# Kill switch del proveedor externo.
# UBER_DIRECT_ENABLED=false
# UBER_DIRECT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# UBER_DIRECT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Customer ID de la cuenta de Uber Direct.
# UBER_DIRECT_CUSTOMER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# true usa el entorno sandbox de Uber (default: producción).
# UBER_DIRECT_SANDBOX=false
# Timeout por petición en ms (default 12000).
# UBER_DIRECT_TIMEOUT_MS=12000

# ---- Tarjeta de lealtad en el teléfono (nivel Diamante) ----
# Apple Wallet y Google Wallet son de PLATAFORMA, igual que el SMS y Uber Direct.
# Ver src/lib/foodos-wallet/apple.ts y google.ts. Sin credenciales NO se rompe
# nada: la tarjeta web (el enlace /r/[slug]/tarjeta/[token] con su QR) hace todo
# el trabajo y los botones de "añadir al teléfono" simplemente no aparecen.
#
# Apple: certificado de Pass Type ID + la WWDR de Apple. Los PEM pueden venir
# con \n escapados (formato de variable de entorno) o multilínea.
# APPLE_WALLET_ENABLED=false
# APPLE_WALLET_PASS_TYPE_ID=pass.com.turestaurante.lealtad
# APPLE_WALLET_TEAM_ID=XXXXXXXXXX
# APPLE_WALLET_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# APPLE_WALLET_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# APPLE_WALLET_WWDR=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Contraseña de la llave, solo si el .p12 exportado la traía.
# APPLE_WALLET_KEY_PASSPHRASE=
#
# Google: emisor de Google Wallet + cuenta de servicio con permiso de escritura
# sobre el issuer. `CLASS_SUFFIX` distingue varias marcas bajo el mismo issuer.
# GOOGLE_WALLET_ENABLED=false
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet@proyecto.iam.gserviceaccount.com
# GOOGLE_WALLET_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# GOOGLE_WALLET_CLASS_SUFFIX=foodos_loyalty

# ---- Sitio web, app de marca y SEO local (nivel Diamante) ----
# Esta capacidad NO necesita credenciales de terceros: sin ninguna variable
# definida funciona completa. Ver src/lib/foodos-seo.ts y src/lib/foodos-ai/seo.ts.
#
# 1) El sitio IA reutiliza la capa de IA de FoodOS (arriba). Si no hay
#    proveedor, el texto sale de plantillas deterministas y el dueño lo edita:
#    la página se guarda igual, en borrador.
# 2) La app de marca es un manifest PWA por restaurante
#    (/r/[slug]/manifest.webmanifest) que se arma con el logo y el color del
#    restaurante; no requiere cuenta de desarrollador.
# 3) Google Business no tiene API sin verificar la propiedad del negocio, así
#    que el panel muestra un checklist de 9 pasos con enlace a
#    https://www.google.com/business/ y el dueño lo completa a mano. No hay
#    variable que lo active.
#
# Único requisito real: NEXT_PUBLIC_SITE_URL (arriba, sección "App") debe ser el
# dominio público. De ahí salen el origen canónico, el sitemap y las URLs que el
# dueño copia del panel. En local (http://localhost:3000) los enlaces se generan
# pero no sirven para compartir.

# ---- Punto de venta (nivel Diamante) ----
# Esta capacidad NO necesita credenciales de terceros para arrancar: sin
# ninguna variable definida el camino que ya funciona es la importación CSV
# del menú en /panel/foodos/menu (formato: categoria,nombre,descripcion,
# precio,costo,tags — los tags van separados por "|").
#
# 1) FoodOS trae un registro de 6 proveedores de punto de venta
#    (src/lib/pos/registry.ts): soft_restaurant, parrot, ncr_aloha, toast,
#    clip y mercado_pago. Los seis aparecen SIEMPRE en el panel, cada uno con
#    la nota de qué le falta.
# 2) Ninguno tiene adaptador implementado todavía. `resolvePosAdapter`
#    (src/lib/pos/adapter.ts) es el punto único de extensión: hoy devuelve
#    `unimplementedPosAdapter`, que reporta honestamente "el adaptador no
#    existe" en lugar de fingir una sincronización. Implementar un proveedor
#    es añadir un archivo y una rama en esa función — no hay variable de
#    entorno que lo active por adelantado.
# 3) Las credenciales de cada proveedor NO van aquí: el dueño las captura en
#    /panel/foodos/pos y se guardan cifradas por fila en
#    `foodos_pos_connections`. Este archivo no necesita nada para que la
#    pantalla funcione.
# 4) El webhook entrante vive en
#    /api/foodos/pos/[provider]/webhook/[restaurantId]. El secreto se genera
#    con el botón "Rotar secreto" del panel (o el primer guardado) y viaja en
#    el header `x-pos-secret`. Sin secreto el endpoint responde 503: es
#    fail-closed a propósito.
#
# Único requisito real: NEXT_PUBLIC_SITE_URL (arriba, sección "App") para que
# la URL del webhook que el dueño copia apunte a tu dominio y no a localhost.

# ---- Catering por volumen (nivel Diamante) ----
# Esta capacidad NO necesita credenciales de terceros: funciona completa sin
# ninguna variable definida. Ver src/lib/foodos-catering.ts.
#
# 1) Los paquetes (precio por persona, mínimo y máximo de personas,
#    anticipación y qué incluye) los captura el dueño en
#    /panel/foodos/catering y se guardan en `foodos_catering_packages`.
# 2) El total SIEMPRE lo calcula el servidor con `quoteCatering` a partir del
#    paquete y el número de personas. El navegador manda cuántas personas van;
#    nunca cuánto cuesta. `overrideCateringTotal` existe solo para ajustes
#    autorizados por el dueño y queda registrado.
# 3) Las solicitudes NO entran a `foodos_orders` hasta que el restaurante
#    confirma el evento: una cotización no es una venta.
# 4) La página pública de paquetes lee solo los activos. No hay variable que
#    la active o desactive: la controla la columna `is_active` de cada paquete.

# ---- Piloto Kie.ai (rutas /api/admin/kie-ai) ----
# Agregador de modelos con un solo API key (imagen, video, música y LLM/chat).
# https://docs.kie.ai/ · Base URL: https://api.kie.ai · Header: Authorization: Bearer <KIE_AI_API_KEY>
# Sin esta variable las rutas responden 500 ("KIE_AI_API_KEY no está configurada").
# El piloto es admin-only: las rutas viven bajo /api/admin y verifican sesión admin.
# OJO: si defines esta variable, la capa de IA de FoodOS (src/lib/ai/llm.ts) la
# usará como proveedor de chat de último recurso para el Mesero IA / Marketing IA.
# KIE_AI_API_KEY=kie-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Obligatoria para POST /api/admin/kie-ai/music: la API de música (Suno) exige un
# callBackUrl. Se toma del body y, si no viene, se usa esta variable. Sin ninguna
# de las dos la ruta responde 400. Debe ser una URL pública accesible por Kie.ai.
# KIEAI_CALLBACK_URL=https://tu-dominio.com/api/webhooks/kie-ai

# ---- Pagos manuales SPEI / OXXO (R6.4) ----
# Datos mostrados al cliente en la página de confirmación cuando elige pagar
# por transferencia (SPEI) o en OXXO. No son credenciales de cobro; son la
# información para que el cliente transfiera/presente la referencia. El admin
# confirma el cobro manualmente (flujo que ya abona el cashback).
# Si no se configuran, la página muestra un mensaje genérico de contacto.
# CLABE interbancaria a 18 dígitos:
# NEXT_PUBLIC_SPEI_CLABE=000000000000000000
# Nombre del beneficiario de la transferencia:
# NEXT_PUBLIC_SPEI_BENEFICIARIO=Resurte.me
# Referencia para pago en OXXO (si usas una fija; si no, se usa el # de pedido):
# NEXT_PUBLIC_OXXO_REFERENCIA=

# Cifrado de tokens de WhatsApp Business de restaurantes (FoodOS).
# Clave simétrica AES-256 (cualquier cadena larga y secreta; si falta,
# se usa SUPABASE_SERVICE_ROLE_KEY como respaldo en servidor).
FOODOS_WA_ENCRYPTION_KEY=

# ---- Observabilidad (bitácora de errores) ----
# No hay variable nueva: `error_logs` (migración 00054) ya existe y la lectura
# admin vive en /admin/bitacoras. Lo que sí hace falta es
# SUPABASE_SERVICE_ROLE_KEY (arriba): la ingesta de servidor
# (`reportServerError()` en src/lib/error-log.ts) escribe con service role, y
# sin la clave el reporte se descarta dejando solo un aviso en consola. El
# endpoint de cliente POST /api/log-error no la necesita.
#
# El dedupe cruzado entre los dos motores de WhatsApp y los KPIs de adopción de
# /admin/restaurantes tampoco introducen variables: todo se calcula en vivo.
