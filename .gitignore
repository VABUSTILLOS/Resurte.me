# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — y cualquier caché de build derivado: NEXT_DIST_DIR (next.config.ts)
# deja al webServer de Playwright elegir su propio distDir, así que el patrón
# tiene que cubrir `.next*` y no solo `.next`; si no, cada distDir nuevo aparece
# como carpeta sin seguimiento en git.
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AGENTS
AGENTS.md
.env*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Verificación de entornos Vercel (secrets redactados)
.env.*.tmp

# Estado local del CLI de Supabase. `pooler-url` contiene la cadena de conexión
# del rol `postgres` CON contraseña: nunca debe versionarse (estuvo commiteado
# hasta 17-sep-2026, ver docs/OPS.md §9). El CLI lo regenera al hacer `supabase link`.
supabase/.temp/

# Softgen - prevent committing dependencies and build artifacts
dist/
.turbo/
.env.local
.env.*.local
*.key
*.jwt
service-account*.json
firebase-service-account.json
credentials.json
.git-credentials
.secrets
